/* ============================================================
   iGameVis Fluent QSS — 「Fluent 工作台」
   参考：Microsoft Fluent 2 / Ansys Discovery Style Guide
   配色：深蓝灰面板 + 亮蓝强调，布局：左树/属性、中央视口、右工具
   ============================================================ */

* {
    font-family: "Segoe UI", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
    outline: none;
}

QMainWindow {
    background-color: #171B22;
}

/* ---------- 自定义标题栏 ---------- */
QWidget#CustomTitleBar {
    background-color: #1B1F26;
    border-bottom: 1px solid #313844;
}

QWidget#CustomTitleBar QMenuBar {
    background-color: transparent;
    color: #A7B0BE;
    padding: 2px 0;
    border: none;
}

QWidget#CustomTitleBar QMenuBar::item {
    background: transparent;
    color: #A7B0BE;
    padding: 4px 12px;
    margin: 0 2px;
    border-radius: 6px;
}

QWidget#CustomTitleBar QMenuBar::item:selected {
    background-color: rgba(96, 205, 255, 0.16);
    color: #F0F6FC;
}

QLabel#CustomTitleLabel {
    color: #E8EDF4;
    font-size: 11pt;
    font-weight: 600;
}

QPushButton#MinimizeButton,
QPushButton#MaximizeButton {
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 7px;
}

QPushButton#MinimizeButton:hover,
QPushButton#MaximizeButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton#MinimizeButton:pressed,
QPushButton#MaximizeButton:pressed {
    background-color: rgba(255, 255, 255, 0.14);
}

QPushButton#CloseButton {
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 7px;
}

QPushButton#CloseButton:hover {
    background-color: #F87171;
    color: white;
}

QPushButton#CloseButton:pressed {
    background-color: #DC2626;
    color: white;
}

/* ---------- 菜单 ---------- */
QMenuBar {
    background-color: #1B1F26;
    color: #E8EDF4;
    padding: 3px 0;
    border: none;
}

QMenuBar::item {
    background: transparent;
    color: #A7B0BE;
    padding: 5px 12px;
    margin: 0 2px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: rgba(96, 205, 255, 0.16);
    color: #FFFFFF;
}

QMenu {
    background-color: #242A33;
    color: #E8EDF4;
    border: 1px solid #3A414D;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    color: #C4CDD9;
    padding: 6px 22px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: rgba(96, 205, 255, 0.20);
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #3A414D;
    margin: 5px 8px;
}

/* ---------- 工具栏 ---------- */
QToolBar {
    background-color: #1B1F26;
    border: none;
    padding: 2px;
}

QToolBar::handle {
    width: 2px;
    background-color: #3A414D;
    margin: 8px 0;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #C4CDD9;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px;
}

QToolBar QToolButton:hover {
    background-color: rgba(96, 205, 255, 0.14);
    border-color: rgba(96, 205, 255, 0.38);
    color: #FFFFFF;
}

QToolBar QToolButton:pressed {
    background-color: rgba(96, 205, 255, 0.26);
}

QToolBar QToolButton:checked {
    background-color: rgba(96, 205, 255, 0.20);
    border-color: rgba(96, 205, 255, 0.52);
    color: #7FD9FF;
}

QToolBar QLabel[objectName^="toolbarTitle"] {
    color: #6E7A8A;
    font-size: 9pt;
    padding: 4px 8px 8px 8px;
    background-color: transparent;
    border: none;
}

/* ---------- 停靠面板 ---------- */
QDockWidget {
    border-radius: 8px;
    border: none;
    color: #E8EDF4;
}

QDockWidget::title {
    background-color: #262C35;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 30px;
    max-height: 30px;
    padding: 2px 10px;
    color: #E8EDF4;
    font-weight: 600;
}

QDockWidget::close-button {
    image: url(:/Ticon/Icons/dock_close_white.svg);
    color: #FFFFFF;
}

QDockWidget::close-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QDockWidget QWidget {
    background-color: #1F242C;
    color: #C4CDD9;
}

QDockWidget QScrollArea,
QDockWidget QScrollArea QWidget,
QDockWidget QFrame,
QDockWidget QTextEdit,
QDockWidget QAbstractScrollArea::viewport {
    background-color: #171B22;
}

/* ---------- 无边框 Filter 弹窗 ---------- */
QDockWidget#IgQtFilterFramelessDock {
    background-color: #171B22;
    border: 1px solid #3A414D;
    border-radius: 10px;
}

QDockWidget#IgQtFilterFramelessDock::title {
    height: 0;
    max-height: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

QDockWidget#IgQtFilterFramelessDock QWidget#FilterFrameTitleBar {
    background-color: #242A33;
    border: 1px solid #3A414D;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QDockWidget#IgQtFilterFramelessDock QLabel#IgQtFilterTitleLabel {
    color: #E8EDF4;
    background: transparent;
    border: none;
}

QDockWidget#IgQtFilterFramelessDock QPushButton#FilterFrameTitleCloseButton {
    background: transparent;
    border: none;
    color: #A7B0BE;
    border-radius: 6px;
}

QDockWidget#IgQtFilterFramelessDock QPushButton#FilterFrameTitleCloseButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #E8EDF4;
}

QDockWidget#IgQtFilterFramelessDock QWidget {
    background-color: #171B22;
}

/* ---------- 图层树悬浮 Dock ---------- */
QDockWidget#LayerTreeDock {
    background-color: #1F242C;
    border: 1px solid #3A414D;
    border-radius: 12px;
}

QDockWidget#LayerTreeDock::title {
    background-color: transparent;
    color: #E8EDF4;
    min-height: 34px;
    max-height: 34px;
    padding: 6px 64px 6px 12px;
    font-weight: 600;
}

QDockWidget#LayerTreeDock QWidget#DockTitleBar {
    background-color: #262C35;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QDockWidget#LayerTreeDock QLabel#DockTitleLabel {
    color: #E8EDF4;
    font-size: 11pt;
    background: transparent;
}

QDockWidget#LayerTreeDock QPushButton#DockTitleCloseButton {
    color: #A7B0BE;
    background: transparent;
    border: none;
    font-size: 13pt;
}

QDockWidget#LayerTreeDock QPushButton#DockTitleCloseButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QDockWidget#LayerTreeDock QWidget,
QDockWidget#LayerTreeDock QFrame,
QDockWidget#LayerTreeDock QScrollArea,
QDockWidget#LayerTreeDock QAbstractScrollArea::viewport {
    background-color: #1F242C;
    border: none;
}

QDockWidget#LayerTreeDock QTreeWidget {
    background-color: #1F242C;
    border: none;
    outline: none;
    color: #C4CDD9;
    alternate-background-color: rgba(255, 255, 255, 0.04);
    show-decoration-selected: 1;
}

QDockWidget#LayerTreeDock QTreeWidget::item:hover {
    background-color: rgba(96, 205, 255, 0.14);
}

QDockWidget#LayerTreeDock QTreeWidget::item:selected {
    background-color: rgba(96, 205, 255, 0.22);
    color: #FFFFFF;
}

/* ---------- 标签页 ---------- */
QTabWidget::pane {
    border: 1px solid #3A414D;
    background-color: #171B22;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #242A33;
    color: #A7B0BE;
    padding: 5px 12px;
    border: 1px solid #3A414D;
    border-bottom: none;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #2A313B;
    color: #7FD9FF;
}

QTabBar::tab:hover:!selected {
    background-color: #262C35;
    color: #E8EDF4;
}

/* ---------- 输入框 / 下拉框 / 数字框 ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #242A33;
    color: #E8EDF4;
    border: 1px solid #3A414D;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #2B7CD3;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #60CDFF;
}

QComboBox::drop-down {
    border-left: 1px solid #3A414D;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/Ticon/Icons/spin_down_silver.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #242A33;
    color: #C4CDD9;
    border: 1px solid #3A414D;
    outline: 0;
    selection-background-color: rgba(96, 205, 255, 0.28);
    selection-color: #FFFFFF;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #2A313B;
    color: #E8EDF4;
    border: 1px solid #3A414D;
    border-radius: 7px;
    padding: 5px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #333B47;
    border-color: rgba(96, 205, 255, 0.42);
}

QPushButton:pressed {
    background-color: #262C35;
    border-color: rgba(96, 205, 255, 0.58);
}

QPushButton:checked {
    background-color: rgba(96, 205, 255, 0.20);
    border-color: rgba(96, 205, 255, 0.55);
    color: #7FD9FF;
}

/* ---------- 复选框 / 单选框 ---------- */
QCheckBox, QRadioButton {
    color: #C4CDD9;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #242A33;
    border: 1px solid #3A414D;
    border-radius: 4px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #60CDFF;
    border: 1px solid #60CDFF;
    border-radius: 4px;
}

/* ---------- 分组框 ---------- */
QGroupBox {
    color: #C4CDD9;
    border: 1px solid #3A414D;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #A7B0BE;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    border: none;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #3A414D;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4A5563;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    border: none;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #3A414D;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4A5563;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 滑块 ---------- */
QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    background-color: #242A33;
    border: 1px solid #3A414D;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #60CDFF, stop:1 #2B7CD3);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background-color: #242A33;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #E8EDF4;
    width: 12px;
    border-radius: 6px;
    margin: -4px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #60CDFF;
}

/* ---------- 树 / 列表 ---------- */
QTreeView, QTreeWidget, QListWidget {
    background-color: #171B22;
    color: #C4CDD9;
    border: 1px solid #3A414D;
    border-radius: 6px;
    alternate-background-color: rgba(255, 255, 255, 0.03);
    show-decoration-selected: 1;
}

QTreeView::item, QTreeWidget::item, QListWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QTreeView::item:hover, QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: rgba(96, 205, 255, 0.12);
}

QTreeView::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: rgba(96, 205, 255, 0.22);
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #262C35;
    color: #A7B0BE;
    border: none;
    border-right: 1px solid #3A414D;
    border-bottom: 1px solid #3A414D;
    padding: 4px 8px;
}

/* ---------- 属性浏览器 ---------- */
QtTreePropertyBrowser, QtPropertyBrowser {
    background-color: #171B22;
    color: #C4CDD9;
}

QtTreePropertyBrowser QTreeWidget,
QtPropertyEditorView {
    alternate-background-color: #1F242C;
    background-color: #1B1F26;
}

QtTreePropertyBrowser QTreeWidget::item,
QtPropertyEditorView::item {
    background-color: #1B1F26;
    color: #C4CDD9;
}

QtTreePropertyBrowser QTreeWidget::item:selected,
QtPropertyEditorView::item:selected {
    background-color: #60CDFF;
    selection-background-color: #60CDFF;
    selection-color: #10151B;
    color: #10151B;
}

QtTreePropertyBrowser QTreeWidget::item:hover,
QtPropertyEditorView::item:hover {
    background-color: rgba(96, 205, 255, 0.14);
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #1B1F26;
    color: #6E7A8A;
    border-top: 1px solid #3A414D;
}

QStatusBar QLabel {
    color: #6E7A8A;
}

/* ---------- Tooltip ---------- */
QToolTip {
    font-size: 9pt;
    color: #E8EDF4;
    background-color: #242A33;
    border: 1px solid #3A414D;
    padding: 6px 10px;
    border-radius: 6px;
}

/* 页签容器：去掉方线框 + 圆角与面板一致 */
QDockWidget#LayerTreeDock QTabWidget::pane,
QDockWidget#LayerPropertiesDock QTabWidget::pane {
    /* 去掉内容区那圈方线框（形似「白色方形边框」，方角还会戳出面板圆弧） */
    border: none;
    border-radius: 12px;
}
