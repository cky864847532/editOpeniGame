/* ============================================================
   iGameVis Modern Dark QSS
   设计来源：ui-mockup/iGameVis_UI_Concept.html
   配色：深空黑 + 青色科技主色 (#38BDF8) + 靛蓝辅色
   ============================================================ */

/* ---------- 全局 ---------- */
* {
    font-family: "PingFang SC Regular", "PingFang SC", "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", "Arial";
    font-size: 13px;
    outline: none;
}

QMainWindow {
    background-color: #0B0E14;
}

/* ---------- 自定义标题栏 ---------- */
QWidget#CustomTitleBar {
    background-color: #0F131A;
    border-bottom: 1px solid #223044;
}

QWidget#CustomTitleBar QMenuBar {
    background-color: transparent;
    color: #9AA7B8;
    padding: 2px 0;
    border: none;
}

QWidget#CustomTitleBar QMenuBar::item {
    background: transparent;
    color: #9AA7B8;
    padding: 4px 12px;
    margin: 0 2px;
    border-radius: 6px;
}

QWidget#CustomTitleBar QMenuBar::item:selected {
    background-color: rgba(56, 189, 248, 0.12);
    color: #E8EEF7;
}

QLabel#CustomTitleLabel {
    color: #E8EEF7;
    font-size: 11pt;
    font-weight: 600;
}

QPushButton#MinimizeButton,
QPushButton#MaximizeButton {
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 7px;
}

QPushButton#MinimizeButton:hover,
QPushButton#MaximizeButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton#MinimizeButton:pressed,
QPushButton#MaximizeButton:pressed {
    background-color: rgba(255, 255, 255, 0.14);
}

QPushButton#CloseButton {
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 7px;
}

QPushButton#CloseButton:hover {
    background-color: #F87171;
    color: white;
}

QPushButton#CloseButton:pressed {
    background-color: #DC2626;
    color: white;
}

/* 风格切换按钮 */
QPushButton#StyleToggleButton {
    border-radius: 8px;
    font-size: 10pt;
    padding: 0 12px;
}

/* ---------- 菜单 ---------- */
QMenuBar {
    background-color: #0F131A;
    color: #E8EEF7;
    padding: 3px 0;
    border: none;
}

QMenuBar::item {
    background: transparent;
    color: #9AA7B8;
    padding: 5px 12px;
    margin: 0 2px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: rgba(56, 189, 248, 0.12);
    color: #E8EEF7;
}

QMenu {
    background-color: #121721;
    color: #E8EEF7;
    border: 1px solid #223044;
    border-radius: 10px;
    padding: 5px;
}

QMenu::item {
    color: #B8C4D4;
    padding: 6px 22px;
    border-radius: 6px;
    text-align: left;
}

QMenu::item:selected {
    background-color: rgba(56, 189, 248, 0.14);
    color: #E8EEF7;
}

QMenu::separator {
    height: 1px;
    background-color: #223044;
    margin: 5px 8px;
}

/* ---------- 工具栏 ---------- */
QToolBar {
    background-color: #0F131A;
    border: none;
    padding: 2px;
}

QToolBar::handle {
    width: 2px;
    background-color: #223044;
    margin: 8px 0;
}

QToolBar QToolButton {
    background-color: transparent;
    color: #B8C4D4;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 2px;
}

QToolBar QToolButton:hover {
    background-color: rgba(56, 189, 248, 0.10);
    border-color: rgba(56, 189, 248, 0.30);
    color: #E8EEF7;
}

QToolBar QToolButton:pressed {
    background-color: rgba(56, 189, 248, 0.18);
}

QToolBar QToolButton:checked {
    background-color: rgba(56, 189, 248, 0.16);
    border-color: rgba(56, 189, 248, 0.45);
    color: #38BDF8;
}

QToolBar QLabel[objectName^="toolbarTitle"] {
    color: #5C6B80;
    font-size: 9pt;
    padding: 4px 8px 8px 8px;
    background-color: transparent;
    border: none;
}

/* ---------- 停靠面板 ---------- */
QDockWidget {
    border-radius: 8px;
    border: none;
    color: #E8EEF7;
}

QDockWidget::title {
    background-color: #161C27;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 30px;
    max-height: 30px;
    padding: 2px 10px;
    color: #E8EEF7;
    font-weight: 600;
}

QDockWidget::close-button {
    image: url(:/Ticon/Icons/dock_close_white.svg);
    color: #FFFFFF;
}

QDockWidget::close-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QDockWidget::float-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QDockWidget QWidget {
    background-color: #121721;
    color: #C2CDDC;
}

QDockWidget QScrollArea,
QDockWidget QScrollArea QWidget,
QDockWidget QFrame,
QDockWidget QTextEdit,
QDockWidget QAbstractScrollArea::viewport {
    background-color: #0F131A;
}

/* ---------- 无边框 Filter 弹窗 ---------- */
QDockWidget#IgQtFilterFramelessDock {
    background-color: #0F131A;
    border: 1px solid #223044;
    border-radius: 10px;
}

QDockWidget#IgQtFilterFramelessDock::title {
    height: 0;
    max-height: 0;
    min-height: 0;
    padding: 0;
    margin: 0;
    border: none;
    background: transparent;
}

QDockWidget#IgQtFilterFramelessDock QWidget#FilterFrameTitleBar {
    background-color: #121721;
    border: 1px solid #223044;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QDockWidget#IgQtFilterFramelessDock QLabel#IgQtFilterTitleLabel {
    color: #E8EEF7;
    background: transparent;
    border: none;
}

QDockWidget#IgQtFilterFramelessDock QPushButton#FilterFrameTitleCloseButton {
    background: transparent;
    border: none;
    color: #9AA7B8;
    border-radius: 6px;
}

QDockWidget#IgQtFilterFramelessDock QPushButton#FilterFrameTitleCloseButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #E8EEF7;
}

QDockWidget#IgQtFilterFramelessDock QWidget {
    background-color: #0F131A;
}

QDockWidget#IgQtFilterFramelessDock QScrollArea,
QDockWidget#IgQtFilterFramelessDock QScrollArea QWidget,
QDockWidget#IgQtFilterFramelessDock QFrame,
QDockWidget#IgQtFilterFramelessDock QAbstractScrollArea::viewport {
    background-color: #0F131A;
}

QDockWidget#IgQtFilterFramelessDock QLabel {
    color: #B8C4D4;
}

/* ---------- 图层树悬浮 Dock ---------- */
QDockWidget#LayerTreeDock {
    background-color: #121721;
    border: 1px solid #223044;
    border-radius: 12px;
}

QDockWidget#LayerTreeDock::title {
    background-color: transparent;
    color: #E8EEF7;
    min-height: 34px;
    max-height: 34px;
    padding: 6px 64px 6px 12px;
    font-weight: 600;
    text-align: left;
}

QDockWidget#LayerTreeDock QWidget#DockTitleBar {
    background-color: #121721;
    border: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
}

QDockWidget#LayerTreeDock QLabel#DockTitleLabel {
    color: #E8EEF7;
    font-size: 11pt;
    background: transparent;
}

QDockWidget#LayerTreeDock QPushButton#DockTitleCloseButton {
    color: #9AA7B8;
    background: transparent;
    border: none;
    font-size: 13pt;
}

QDockWidget#LayerTreeDock QPushButton#DockTitleCloseButton:hover {
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 6px;
}

QDockWidget#LayerTreeDock QWidget,
QDockWidget#LayerTreeDock QFrame,
QDockWidget#LayerTreeDock QScrollArea,
QDockWidget#LayerTreeDock QAbstractScrollArea::viewport {
    background-color: #121721;
    border: none;
}

QDockWidget#LayerTreeDock QTreeWidget {
    background-color: #121721;
    border: none;
    outline: none;
    color: #C2CDDC;
    alternate-background-color: rgba(255, 255, 255, 0.04);
    show-decoration-selected: 1;
}

QDockWidget#LayerTreeDock QTreeWidget::item {
    border: none;
    padding: 4px 10px;
    min-height: 30px;
}

QDockWidget#LayerTreeDock QTreeWidget::item:hover {
    background-color: rgba(56, 189, 248, 0.10);
}

QDockWidget#LayerTreeDock QTreeWidget::item:selected {
    background-color: rgba(56, 189, 248, 0.18);
    color: #E8EEF7;
}

QDockWidget#LayerTreeDock QTreeWidget::branch {
    background-color: #121721;
}

/* ---------- 标签页 ---------- */
QTabWidget::pane {
    border: 1px solid #223044;
    background-color: #0F131A;
    border-radius: 6px;
}

QTabBar::tab {
    background-color: #121721;
    color: #9AA7B8;
    padding: 5px 12px;
    border: 1px solid #223044;
    border-bottom: none;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:selected {
    background-color: #1B2431;
    color: #38BDF8;
}

QTabBar::tab:hover:!selected {
    background-color: #161C27;
    color: #E8EEF7;
}

QTabWidget#LeftFieldTabs QTabBar {
    color: #9AA7B8;
}

QTabWidget#LeftFieldTabs QTabBar::tab:selected {
    color: #38BDF8;
}

QTabWidget#LeftFieldTabs QTabBar::close-button {
    image: url(:/Ticon/Icons/tab_close_muted.svg);
    width: 14px;
    height: 14px;
    subcontrol-origin: padding;
    subcontrol-position: center;
    margin: 1px 4px 1px 2px;
    border: none;
    background: transparent;
}

QTabWidget#LeftFieldTabs QTabBar::close-button:hover {
    image: url(:/Ticon/Icons/tab_close_muted_hover.svg);
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 3px;
}

/* ---------- 输入框 / 下拉框 / 数字框 ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #161C27;
    color: #E8EEF7;
    border: 1px solid #223044;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #0E639C;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #38BDF8;
}

QComboBox::drop-down {
    border-left: 1px solid #223044;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(:/Ticon/Icons/spin_down_silver.svg);
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #121721;
    color: #C2CDDC;
    border: 1px solid #223044;
    outline: 0;
    selection-background-color: rgba(56, 189, 248, 0.22);
    selection-color: #E8EEF7;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #223044;
    border-top-right-radius: 6px;
    background-color: #1B2431;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
    border-left: 1px solid #223044;
    border-top: 1px solid #223044;
    border-bottom-right-radius: 6px;
    background-color: #1B2431;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #212C3B;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/Ticon/Icons/spin_up_silver.svg);
    width: 9px;
    height: 9px;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/Ticon/Icons/spin_down_silver.svg);
    width: 9px;
    height: 9px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #1B2431;
    color: #E8EEF7;
    border: 1px solid #223044;
    border-radius: 7px;
    padding: 5px 14px;
    min-height: 22px;
}

QPushButton:hover {
    background-color: #212C3B;
    border-color: rgba(56, 189, 248, 0.40);
}

QPushButton:pressed {
    background-color: #16202C;
    border-color: rgba(56, 189, 248, 0.55);
}

QPushButton:checked {
    background-color: rgba(56, 189, 248, 0.16);
    border-color: rgba(56, 189, 248, 0.50);
    color: #38BDF8;
}

/* ---------- 复选框 / 单选框 ---------- */
QCheckBox, QRadioButton {
    color: #C2CDDC;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 14px;
    height: 14px;
}

QCheckBox::indicator:unchecked, QRadioButton::indicator:unchecked {
    background-color: #161C27;
    border: 1px solid #223044;
    border-radius: 4px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #38BDF8;
    border: 1px solid #38BDF8;
    border-radius: 4px;
}

/* ---------- 分组框 ---------- */
QGroupBox {
    color: #C2CDDC;
    border: 1px solid #223044;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #9AA7B8;
}

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    border: none;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background-color: #223044;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #2E3D52;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: transparent;
    border: none;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #223044;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #2E3D52;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- 滑块 ---------- */
QSlider {
    background: transparent;
}

QSlider::groove:horizontal {
    background-color: #161C27;
    border: 1px solid #223044;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #38BDF8, stop:1 #6366F1);
    border-radius: 3px;
}

QSlider::add-page:horizontal {
    background-color: #161C27;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #E8EEF7;
    width: 12px;
    border-radius: 6px;
    margin: -4px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #38BDF8;
}

QSlider::groove:vertical {
    background-color: #161C27;
    border: 1px solid #223044;
    width: 6px;
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6366F1, stop:1 #38BDF8);
    border-radius: 3px;
}

QSlider::add-page:vertical {
    background-color: #161C27;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background-color: #E8EEF7;
    height: 12px;
    border-radius: 6px;
    margin: 0 -4px;
}

QSlider::handle:vertical:hover {
    background-color: #38BDF8;
}

/* ---------- 树 / 列表 ---------- */
QTreeView, QTreeWidget, QListWidget {
    background-color: #0F131A;
    color: #C2CDDC;
    border: 1px solid #223044;
    border-radius: 6px;
    alternate-background-color: rgba(255, 255, 255, 0.03);
    show-decoration-selected: 1;
}

QTreeView::item, QTreeWidget::item, QListWidget::item {
    padding: 3px 6px;
    border-radius: 4px;
}

QTreeView::item:hover, QTreeWidget::item:hover, QListWidget::item:hover {
    background-color: rgba(56, 189, 248, 0.10);
}

QTreeView::item:selected, QTreeWidget::item:selected, QListWidget::item:selected {
    background-color: rgba(56, 189, 248, 0.20);
    color: #E8EEF7;
}

QTreeView::branch {
    background-color: transparent;
}

QHeaderView::section {
    background-color: #161C27;
    color: #9AA7B8;
    border: none;
    border-right: 1px solid #223044;
    border-bottom: 1px solid #223044;
    padding: 4px 8px;
}

/* ---------- 属性浏览器 ---------- */
QtTreePropertyBrowser, QtPropertyBrowser {
    background-color: #0F131A;
    color: #C2CDDC;
    alternate-background-color: #141A24;
}

QtTreePropertyBrowser QTreeWidget,
QtPropertyEditorView {
    alternate-background-color: #141A24;
    background-color: #121721;
}

QtTreePropertyBrowser QTreeWidget::item,
QtPropertyEditorView::item {
    background-color: #121721;
    color: #C2CDDC;
}

QtTreePropertyBrowser QTreeWidget::item:alternate,
QtPropertyEditorView::item:alternate {
    background-color: #141A24;
    color: #C2CDDC;
}

QtTreePropertyBrowser QTreeWidget::item:selected,
QtPropertyEditorView::item:selected {
    background-color: #38BDF8;
    selection-background-color: #38BDF8;
    selection-color: #06121F;
    color: #06121F;
}

QtTreePropertyBrowser QTreeWidget::item:hover,
QtPropertyEditorView::item:hover {
    background-color: rgba(56, 189, 248, 0.10);
}

QtTreePropertyBrowser QTreeView::branch:closed:has-children:has-siblings,
QtTreePropertyBrowser QTreeView::branch:closed:has-children:!has-siblings,
QtPropertyEditorView::branch:closed:has-children:has-siblings,
QtPropertyEditorView::branch:closed:has-children:!has-siblings {
    image: url(:/Ticon/Icons/tree_arrow_right_silver.svg);
}

QtTreePropertyBrowser QTreeView::branch:open:has-children:has-siblings,
QtTreePropertyBrowser QTreeView::branch:open:has-children:!has-siblings,
QtPropertyEditorView::branch:open:has-children:has-siblings,
QtPropertyEditorView::branch:open:has-children:!has-siblings {
    image: url(:/Ticon/Icons/tree_arrow_down_silver.svg);
}

/* ---------- 状态栏 ---------- */
QStatusBar {
    background-color: #0F131A;
    color: #5C6B80;
    border-top: 1px solid #223044;
}

QStatusBar QLabel {
    color: #5C6B80;
}

/* ---------- 张量场面板文字 ---------- */
QWidget#widget_TensorField QLabel,
QWidget#widget_TensorField QPushButton {
    color: #E8EEF7;
}

/* ---------- Tooltip ---------- */
QToolTip {
    font-size: 9pt;
    color: #E8EEF7;
    background-color: #121721;
    border: 1px solid #223044;
    padding: 6px 10px;
    border-radius: 6px;
}

/* 页签容器：去掉方线框 + 圆角与面板一致 */
QDockWidget#LayerTreeDock QTabWidget::pane,
QDockWidget#LayerPropertiesDock QTabWidget::pane {
    /* 去掉内容区那圈方线框（形似「白色方形边框」，方角还会戳出面板圆弧） */
    border: none;
    border-radius: 12px;
}
